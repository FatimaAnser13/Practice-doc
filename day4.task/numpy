#Find the maximum and minimum values of an array.
import numpy as np

arr = np.array([10, 20, 30, 40, 50])

print("Maximum:", np.max(arr))
print("Minimum:", np.min(arr))


#Calculate the average of [10, 20, 30, 40, 50].
import numpy as np

arr = np.array([10, 20, 30, 40, 50])

average = np.mean(arr)

print("Average:", average)


